# === Docker Compose (root) ===
POSTGRES_USER=imperio
POSTGRES_PASSWORD=imperio_secret
POSTGRES_DB=imperio_acai
POSTGRES_PORT=5433

BACKEND_PORT=4000
FRONTEND_PORT=8080

JWT_ACCESS_SECRET=change-me-access-super-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-super-secret-min-32-chars-long!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

FRONTEND_URL=http://localhost:8080
PUBLIC_UPLOAD_URL=http://localhost:8080/uploads
VITE_API_URL=http://localhost:4000/api

# === Backend local (arquivo backend/.env) ===
# Use a MESMA porta publicada acima em POSTGRES_PORT (ex.: 5433 → localhost:5433).
# DATABASE_URL=postgresql://imperio:imperio_secret@localhost:5433/imperio_acai?schema=public
# NODE_ENV=development
# PORT=4000

# === Frontend local (.env in /frontend) ===
# VITE_API_URL=http://localhost:4000/api
