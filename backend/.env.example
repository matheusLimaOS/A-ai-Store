# Copie para .env e ajuste. O servidor carrega este arquivo via dotenv (config/env.ts).

# --- PostgreSQL (obrigatório) ---
# Projeto padronizado na porta do host 5433 (mapeamento do Docker: POSTGRES_PORT=5433 → localhost:5433).
# Backend rodando no host (npm run dev) → use localhost:5433 nesta URL.
# Backend dentro do container não usa este arquivo: no compose a URL usa host "postgres" e porta interna 5432.
DATABASE_URL=postgresql://imperio:imperio_secret@localhost:5433/imperio_acai?schema=public

NODE_ENV=development
PORT=4000

JWT_ACCESS_SECRET=dev-access-secret-change-in-prod-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Origem do front em dev (CORS em produção; em development o CORS aceita qualquer origin)
FRONTEND_URL=http://localhost:5173

UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads
