# URL base que o axios usa no browser. Com /api, as requisições vão para o MESMO host da página
# (ex.: localhost:5173) e o Vite faz proxy para a API — por isso no DevTools aparece :5173.
VITE_API_URL=/api

# Destino do proxy do Vite (só desenvolvimento). Precisa ser a mesma porta do backend (backend/.env → PORT).
DEV_API_PROXY_TARGET=http://localhost:4000

# Opcional: testar no celular via cloudflared. Coloque APENAS o hostname (sem https://).
# Ex.: abc-xyz.trycloudflare.com — copie do URL que o cloudflared imprime.
# Depois de alterar, reinicie o Vite. Sem essa variável, o bundle ainda aponta para localhost:5173
# e no celular aparece ERR_EMPTY_RESPONSE / WebSocket do HMR falha.
# DEV_TUNNEL_HOST=xxxx.trycloudflare.com
